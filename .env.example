# Copy to .env.local (gitignored). Never commit real values.

# OpenAI — server only. Leave empty to use the mock AI (src/server/ai/mock.ts).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Set to 1 to force the mock AI even when a key is present.
AI_MOCK=

# Neon Postgres. Leave empty to use the in-memory repository (data resets on restart).
DATABASE_URL=
